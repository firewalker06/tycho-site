---
import '../styles/site.css';
import DeviceFrame from '../components/DeviceFrame.astro';
import CommandBlock from '../components/CommandBlock.astro';

const desktopScreenshot = '/assets/quickstart-watch-v0.16.0.png';
const desktopScreenshotAlt = 'Tycho Remote UI showing agent sessions with active work, completed results, and sessions that need input.';

const workflows = [
	{
		label: 'Launch',
		title: 'Launch an agent session from a registered project.',
		image: '/assets/quickstart-launch-v0.16.0.png',
		alt: 'Tycho quick agent modal populated for the registered Atlas Web project, ready to create and run a session.',
	},
	{
		label: 'Watch',
		title: 'Review active work, completed results, and sessions that need input.',
		image: desktopScreenshot,
		alt: desktopScreenshotAlt,
		width: 1440,
		height: 900,
	},
	{
		label: 'Answer',
		title: 'Answer questions or send follow-ups when the session needs direction.',
		image: '/assets/quickstart-answer-v0.16.0.png',
		alt: 'Tycho Remote UI showing the Checkout rollout session waiting for a rollout-window decision.',
	},
	{
		label: 'Resume',
		title: 'Resume or re-run work with Tycho keeping the durable session record.',
		image: '/assets/quickstart-resume-v0.16.0.png',
		alt: 'Tycho Remote UI showing a completed Accessibility audit run and the composer for a follow-up.',
	},
];

const title = 'Tycho - Supervise coding agents.';
const description = 'Tycho is a local-first operator console for supervising coding agents.';
const ogImageAlt = 'Tycho home page: Supervise coding agents, with a laptop and phone showing agent sessions in a filterable list.';
const canonicalUrl = 'https://usetycho.com/';
const ogImage = 'https://usetycho.com/og-image.png';
const currentVersion = 'v0.16.0';
const currentReleaseUrl = `https://github.com/firewalker06/tycho/releases/tag/${currentVersion}`;
const changelogUrl = 'https://github.com/firewalker06/tycho/releases';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon-32x32.png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#11100e" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Tycho" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
	</head>
	<body>
		<header class="site-header">
			<div class="brand-lockup">
				<a class="brand" href="/" aria-label="Tycho home">
					<img src="/assets/tycho-logo-only.svg" alt="" />
					<span>Tycho</span>
				</a>
				<a class="version-badge" href={currentReleaseUrl} aria-label={`Tycho ${currentVersion} release notes`}>
					{currentVersion}
				</a>
			</div>
			<nav aria-label="Primary">
				<a href="/docs/getting-started/">Docs</a>
				<a href={changelogUrl}>Changelog</a>
				<a href="https://github.com/firewalker06/tycho">GitHub</a>
			</nav>
		</header>

		<main>
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Local-first control for coding agents</p>
					<h1>Supervise coding agents.</h1>
					<p class="lede">
						Tycho helps you see which agent sessions deserve your attention. Launch, monitor, switch, and continue
						agent work across your repos.
					</p>
					<p class="compatibility">
						Your project config, logs, prompts, and history stay under your control.
						Built-in support for Codex, Claude, OpenCode, and Pi.
					</p>
					<div class="actions">
						<a class="button primary" href="#install">Install Tycho</a>
						<a class="button secondary" href="https://github.com/firewalker06/tycho">View on GitHub</a>
					</div>
				</div>

				<div class="hero-visual">
					<DeviceFrame
						device="laptop"
						src={desktopScreenshot}
						alt={desktopScreenshotAlt}
						width={1920}
						height={1200}
						loading="eager"
					/>
					<DeviceFrame
						device="phone"
						src="/assets/remote-mobile-agents-v0.16.0.png"
						alt="Tycho Remote UI on a phone showing nine agent sessions in a filterable list."
						width={780}
						height={1688}
						loading="eager"
					/>
				</div>
			</section>


			<section class="installation" id="install" aria-labelledby="install-heading">
				<div class="section-heading">
					<p class="eyebrow">Start in your browser</p>
					<h2 id="install-heading">Install Tycho. Start your first agent.</h2>
					<p>Use the built-in Welcome Sandbox. Add your own projects later.</p>
				</div>
				<div class="install-step-heading"><span>01</span><h3>Install and start the browser UI.</h3></div>
				<p class="install-prerequisite">First, install and authenticate a supported coding-agent CLI on this computer. <a href="/docs/configuration/harnesses/">Check harness setup</a>.</p>
				<p class="install-publication">v0.16.0 Homebrew bottle publication is not yet verified. Check the <a href="https://github.com/firewalker06/homebrew-tycho/releases/tag/tycho-0.16.0">Homebrew release</a> before using the Homebrew paths below. You can <a href="/docs/getting-started/#install-from-source">install the published source</a> now.</p>
				<div class="platform-grid">
					<article class="platform-card" aria-labelledby="install-macos">
						<h4 id="install-macos">macOS</h4>
						<p>Apple Silicon: with Homebrew installed and v0.16.0 bottles published, run:</p>
						<CommandBlock label="macOS install and start" command={'brew tap firewalker06/tycho\nbrew install tycho\ntycho --version\ntycho serve --host 127.0.0.1 --port 7373'} />
						<p>Intel Mac or a platform without a bottle? Use the <a href="/docs/getting-started/#install-from-source">source path</a>. v0.11.0 was the final Intel bottle.</p>
					</article>
					<article class="platform-card" aria-labelledby="install-linux">
						<h4 id="install-linux">Linux</h4>
						<p>With Homebrew installed and a v0.16.0 bottle for your platform published, run:</p>
						<CommandBlock label="Linux install and start" command={'brew tap firewalker06/tycho\nbrew install tycho\ntycho --version\ntycho serve --host 127.0.0.1 --port 7373'} />
						<p>Without a supported bottle, use the <a href="/docs/getting-started/#install-from-source">source path</a> with Ruby 4.0.9+, Bundler, Go, and native build tools.</p>
					</article>
					<article class="platform-card" aria-labelledby="install-windows">
						<h4 id="install-windows">Windows · WSL2</h4>
						<p>Use a Linux distribution inside WSL2. Install Ruby 4.0.9+, Bundler, Git, Go, native build tools, and your harness there. Then run:</p>
						<CommandBlock label="WSL2 source install and start" command={'git clone --branch v0.16.0 https://github.com/firewalker06/tycho.git\ncd tycho\nbin/setup --check\nbin/setup\nbin/tycho --version\nbin/tycho serve --host 127.0.0.1 --port 7373'} />
						<p>This is a WSL2 source path, not a native Windows install. See <a href="/docs/getting-started/#requirements">detailed requirements</a>.</p>
					</article>
				</div>
				<p class="install-note">Confirm the version is <strong>0.16.0</strong> before starting. Already installed? Read the <a href="/docs/getting-started/#install-with-homebrew">upgrade steps</a> before updating queue storage.</p>
				<div class="first-run-grid">
					<article>
						<div class="install-step-heading"><span>02</span><h3>Open Tycho.</h3></div>
						<p>Keep the terminal running. Open <a href="http://127.0.0.1:7373">Tycho in your browser</a> on the same computer. WSL2 users can open this address in their Windows browser.</p>
						<p>This command uses localhost. For another device, follow the <a href="/docs/getting-started/remote-ui/#protect-non-local-access">token and tailnet setup</a>.</p>
					</article>
					<article>
						<div class="install-step-heading"><span>03</span><h3>Run an agent in Welcome Sandbox.</h3></div>
						<ol>
							<li>On a new install, select <strong>Create Welcome Sandbox</strong>. Tycho sets up its built-in starter project.</li>
							<li>Open <strong>Welcome Sandbox</strong>, then select <strong>New agent</strong>.</li>
							<li>In <strong>Options → Advanced</strong>, choose your installed, authenticated harness. Paste this prompt, then select <strong>Create and Run</strong>.</li>
						</ol>
						<CommandBlock label="First agent prompt" command="Read README.md and notes.md. Add one practical next step to notes.md, then summarize the change." />
						<p>Watch the result, then send a follow-up in the same session. <a href="/docs/getting-started/">Follow the full getting-started guide</a>.</p>
					</article>
				</div>
			</section>

			<section class="workflow" aria-labelledby="workflow-heading">
				<div class="section-heading workflow-heading">
					<p class="eyebrow">From first run to follow-up</p>
					<h2 id="workflow-heading">Install Tycho, then supervise your first agent session.</h2>
				</div>
				<tycho-carousel class="workflow-carousel">
					<ol class="workflow-tabs" aria-label="Quickstart steps">
						{workflows.map((item, index) => (
							<li>
								<a
									class="workflow-tab"
									href={`#workflow-panel-${index + 1}`}
									id={`workflow-tab-${index + 1}`}
									data-carousel-tab
								>
									<span class="workflow-tab-number" aria-hidden="true">{index + 1}</span>
									<span>{item.label}</span>
								</a>
							</li>
						))}
					</ol>
					<ol class="workflow-panels">
						{workflows.map((item, index) => (
							<li
								class="workflow-panel"
								id={`workflow-panel-${index + 1}`}
								aria-labelledby={`workflow-tab-${index + 1}`}
								data-carousel-panel
							>
								<div class="workflow-panel-heading">
									<span class="workflow-panel-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
									<h3>{item.title}</h3>
								</div>
								<figure>
									<img
										class="workflow-screenshot"
										src={item.image}
										alt={item.alt}
										width={item.width ?? 1440}
										height={item.height ?? 900}
										loading={index === 0 ? 'eager' : 'lazy'}
										decoding="async"
									/>
								</figure>
							</li>
						))}
					</ol>
				</tycho-carousel>
				<a class="text-link workflow-quickstart-link" href="/docs/getting-started/">Read the quickstart</a>
			</section>
		</main>
		<script>
			class TychoCarousel extends HTMLElement {
				connectedCallback() {
					const tabs = [...this.querySelectorAll('[data-carousel-tab]')];
					const panels = [...this.querySelectorAll('[data-carousel-panel]')];
					if (tabs.length === 0 || tabs.length !== panels.length) return;

					const tablist = this.querySelector('.workflow-tabs');
					const panelList = this.querySelector('.workflow-panels');
					tablist?.setAttribute('role', 'tablist');
					panelList?.setAttribute('role', 'none');
					tabs.forEach((tab) => tab.parentElement?.setAttribute('role', 'presentation'));
					tabs.forEach((tab, index) => {
						tab.setAttribute('role', 'tab');
						tab.setAttribute('aria-controls', panels[index].id);
					});
					panels.forEach((panel) => {
						panel.setAttribute('role', 'tabpanel');
						panel.setAttribute('tabindex', '0');
					});

					const select = (selectedIndex, moveFocus = false) => {
						tabs.forEach((tab, index) => {
							const selected = index === selectedIndex;
							tab.setAttribute('aria-selected', String(selected));
							tab.setAttribute('tabindex', selected ? '0' : '-1');
							panels[index].hidden = !selected;
						});
						if (moveFocus) tabs[selectedIndex].focus();
					};

					const hashIndex = panels.findIndex((panel) => `#${panel.id}` === window.location.hash);
					select(hashIndex >= 0 ? hashIndex : 0);

					tabs.forEach((tab, index) => {
						tab.addEventListener('click', (event) => {
							event.preventDefault();
							select(index);
						});
							tab.addEventListener('keydown', (event) => {
							let nextIndex;
							switch (event.key) {
								case 'Enter':
								case ' ':
									nextIndex = index;
									break;
								case 'ArrowRight':
								case 'ArrowDown':
									nextIndex = (index + 1) % tabs.length;
									break;
								case 'ArrowLeft':
								case 'ArrowUp':
									nextIndex = (index - 1 + tabs.length) % tabs.length;
									break;
								case 'Home':
									nextIndex = 0;
									break;
								case 'End':
									nextIndex = tabs.length - 1;
									break;
								default:
									return;
							}
							event.preventDefault();
							select(nextIndex, true);
						});
					});
				}
			}

			if (!customElements.get('tycho-carousel')) customElements.define('tycho-carousel', TychoCarousel);
		</script>
	</body>
</html>
