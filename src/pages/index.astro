---
import '../styles/site.css';

const pillars = [
	{
		title: 'Supervise',
		body: 'See active, waiting, completed, and failed agent sessions across every project from one operator view.',
	},
	{
		title: 'Switch',
		body: 'Move between coding agents without changing how you launch work, follow progress, or continue a session.',
	},
	{
		title: 'Loop',
		body: 'Keep work moving through questions, follow-ups, logs, reviews, re-runs, schedules, and resumed context.',
	},
];

const workflows = [
	{
		title: 'Launch an agent session from a registered project.',
		image: '/assets/quickstart-launch-v0.10.0.png',
		alt: 'Tycho v0.10.0 New agent form for the Web project, ready to create and run the Quickstart notes session.',
	},
	{
		title: 'Watch status, logs, and attention states without hunting through terminal tabs.',
		image: '/assets/quickstart-watch-v0.10.0.png',
		alt: 'Tycho v0.10.0 Remote UI showing the Quickstart notes session running with its prompt and live file-reading activity.',
	},
	{
		title: 'Answer questions or send follow-ups when the session needs direction.',
		image: '/assets/quickstart-answer-v0.10.0.png',
		alt: 'Tycho v0.10.0 Remote UI showing the Quickstart notes session waiting for a required Terminal UI or Remote UI decision.',
	},
	{
		title: 'Resume or re-run work with Tycho keeping the durable session record.',
		image: '/assets/quickstart-resume-v0.10.0.png',
		alt: 'Tycho v0.10.0 Remote UI showing two recorded Quickstart notes runs and a follow-up ready to resume the same session.',
	},
];

const releaseHighlights = [
	{
		title: 'Delegate with a durable trail',
		body: 'Link parent and child agent sessions, return terminal reports to the parent, and keep both directions navigable after archive.',
	},
	{
		title: 'Measure real usage',
		body: 'Query normalized run and native-session tokens and estimated cost without turning missing provider data into zero.',
	},
	{
		title: 'Operate configured servers',
		body: 'Use --server for remote project inspection and the full agent-session lifecycle with private, server-bound credentials.',
	},
	{
		title: 'Browse workspaces safely',
		body: 'Inspect bounded directory listings and read-only text previews in Remote UI while Tycho enforces path, file, and size controls.',
	},
];

const title = 'Tycho - Supervise coding agents across projects';
const description = 'Tycho is a local-first operator console for supervising coding agents across projects.';
const canonicalUrl = 'https://usetycho.com/';
const ogImage = 'https://usetycho.com/og-image.png';
const currentVersion = 'v0.10.0';
const currentReleaseUrl = `https://github.com/firewalker06/tycho/releases/tag/${currentVersion}`;
const changelogUrl = 'https://github.com/firewalker06/tycho/releases';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon-32x32.png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#11100e" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Tycho" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
	</head>
	<body>
		<header class="site-header">
			<div class="brand-lockup">
				<a class="brand" href="/" aria-label="Tycho home">
					<img src="/assets/tycho-logo-only.svg" alt="" />
					<span>Tycho</span>
				</a>
				<a class="version-badge" href={currentReleaseUrl} aria-label={`Tycho ${currentVersion} release notes`}>
					{currentVersion}
				</a>
			</div>
			<nav aria-label="Primary">
				<a href="/docs/getting-started/">Docs</a>
				<a href={changelogUrl}>Changelog</a>
				<a href="https://github.com/firewalker06/tycho">GitHub</a>
			</nav>
		</header>

		<main>
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Local-first control for coding agents</p>
					<h1>Supervise coding agents across projects.</h1>
					<p class="lede">
						Tycho gives solo developers and technical leads one place to launch, monitor, switch, and continue
						agent work across their repos.
					</p>
					<p class="compatibility">
						Built-in support for Codex, Claude, and OpenCode.
					</p>
					<div class="actions">
						<a class="button primary" href="/docs/getting-started/">Install Tycho</a>
						<a class="button secondary" href="https://github.com/firewalker06/tycho">View on GitHub</a>
					</div>
				</div>

				<div class="hero-visual" aria-label="Composed Tycho terminal and Remote UI screenshots">
					<div class="screen screen-tui">
						<div class="screen-label">Terminal UI</div>
						<img src="/assets/tui-agents-v0.10.0.png" alt="Tycho v0.10.0 terminal dashboard with three agent sessions" />
					</div>
					<div class="screen screen-web">
						<div class="screen-label">Remote UI</div>
						<img src="/assets/web-delegation-v0.10.0.png" alt="Tycho v0.10.0 Remote UI showing a parent session, delegated child sessions, and a returned report" />
					</div>
				</div>
			</section>

			<section class="proof">
				<div>
					<h2>Local-first by default</h2>
					<p>
						Tycho coordinates your local tools, local repos, local logs, and local agent history instead of
						forcing the workflow into a hosted SaaS control plane.
					</p>
				</div>
				<div>
					<h2>Attention stays scarce</h2>
					<p>Tycho helps you see which agent sessions deserve your attention.</p>
				</div>
			</section>

			<section class="pillars" aria-labelledby="pillars-heading">
				<div class="section-heading">
					<p class="eyebrow">The operator loop</p>
					<h2 id="pillars-heading">Supervise, Switch, Loop.</h2>
				</div>
				<div class="pillar-grid">
					{pillars.map((pillar) => (
						<article class="pillar">
							<h3>{pillar.title}</h3>
							<p>{pillar.body}</p>
						</article>
					))}
				</div>
			</section>

			<section class="release" aria-labelledby="release-heading">
				<div class="section-heading">
					<p class="eyebrow">New in v0.10.0</p>
					<h2 id="release-heading">Coordinate more work without losing the trail.</h2>
					<p>
						The latest release expands delegation, observability, remote control, and safe workspace access while
						keeping existing local workflows compatible.
					</p>
				</div>
				<div class="release-grid">
					{releaseHighlights.map((highlight) => (
						<article>
							<h3>{highlight.title}</h3>
							<p>{highlight.body}</p>
						</article>
					))}
				</div>
				<div class="release-actions">
					<a class="text-link" href={currentReleaseUrl}>Read the v0.10.0 release notes</a>
					<a class="text-link" href="/docs/reference/">See the new CLI commands</a>
				</div>
			</section>

			<section class="workflow" aria-labelledby="workflow-heading">
				<div class="section-heading workflow-heading">
					<p class="eyebrow">From first run to follow-up</p>
					<h2 id="workflow-heading">Install Tycho, then supervise your first agent session.</h2>
				</div>
				<ol class="workflow-steps">
					{workflows.map((item, index) => (
						<li>
							<div class="workflow-step">
								<h3>{item.title}</h3>
								<figure>
									<a class="workflow-screenshot" href={item.image}>
										<img
											src={item.image}
											alt={item.alt}
											width="1440"
											height="900"
											loading="lazy"
											decoding="async"
										/>
										<span>
											Open full-size screenshot
											<span class="sr-only"> for step {index + 1}: {item.title}</span>
										</span>
									</a>
								</figure>
							</div>
						</li>
					))}
				</ol>
				<a class="text-link workflow-quickstart-link" href="/docs/getting-started/">Read the quickstart</a>
			</section>
		</main>
	</body>
</html>
