---
import '../styles/site.css';

const pillars = [
	{
		title: 'Supervise',
		body: 'See active, waiting, completed, and failed agent sessions across every project from one operator view.',
	},
	{
		title: 'Switch',
		body: 'Use Codex, Claude, OpenCode, or custom Claude-compatible harnesses without changing how you launch and follow work.',
	},
	{
		title: 'Loop',
		body: 'Keep work moving through questions, follow-ups, logs, reviews, re-runs, schedules, and resumed context.',
	},
];

const workflows = [
	'Launch an agent session from a registered project.',
	'Watch status, logs, and attention states without hunting through terminal tabs.',
	'Answer questions or send follow-ups when the session needs direction.',
	'Resume or re-run work with Tycho keeping the durable session record.',
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Tycho - Supervise many AI coding sessions across projects</title>
		<meta
			name="description"
			content="Tycho is a local-first operator console for supervising many AI coding sessions across projects."
		/>
		<link rel="icon" href="/favicon.svg" />
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/" aria-label="Tycho home">
				<img src="/assets/tycho-logo-only.svg" alt="" />
				<span>Tycho</span>
			</a>
			<nav aria-label="Primary">
				<a href="/docs/getting-started/">Docs</a>
				<a href="https://github.com/firewalker06/tycho">GitHub</a>
			</nav>
		</header>

		<main>
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Local-first control for coding agents</p>
					<h1>Supervise many AI coding sessions across projects.</h1>
					<p class="lede">
						Tycho gives solo developers and technical leads one place to launch, monitor, switch, and continue
						agent work across their repos.
					</p>
					<div class="actions">
						<a class="button primary" href="/docs/getting-started/">Get started</a>
						<a class="button secondary" href="https://github.com/firewalker06/tycho">View on GitHub</a>
					</div>
				</div>

				<div class="hero-visual" aria-label="Composed Tycho terminal and Remote UI screenshots">
					<div class="screen screen-tui">
						<div class="screen-label">Terminal UI</div>
						<img src="/assets/tui-agents-list.png" alt="Tycho TUI agents dashboard" />
					</div>
					<div class="screen screen-web">
						<div class="screen-label">Remote UI</div>
						<img src="/assets/web-now.png" alt="Tycho Remote UI Now view" />
					</div>
				</div>
			</section>

			<section class="proof">
				<div>
					<h2>Local-first by default</h2>
					<p>
						Tycho coordinates your local tools, local repos, local logs, and local agent history instead of
						forcing the workflow into a hosted SaaS control plane.
					</p>
				</div>
				<div>
					<h2>Attention stays scarce</h2>
					<p>Tycho helps you see which agent sessions deserve your attention.</p>
				</div>
			</section>

			<section class="pillars" aria-labelledby="pillars-heading">
				<div class="section-heading">
					<p class="eyebrow">The operator loop</p>
					<h2 id="pillars-heading">Supervise, Switch, Loop.</h2>
				</div>
				<div class="pillar-grid">
					{pillars.map((pillar) => (
						<article class="pillar">
							<h3>{pillar.title}</h3>
							<p>{pillar.body}</p>
						</article>
					))}
				</div>
			</section>

			<section class="workflow" aria-labelledby="workflow-heading">
				<div class="workflow-copy">
					<p class="eyebrow">From first run to follow-up</p>
					<h2 id="workflow-heading">Install Tycho, then supervise your first agent session.</h2>
					<ol>
						{workflows.map((item) => <li>{item}</li>)}
					</ol>
					<a class="text-link" href="/docs/getting-started/">Read the quickstart</a>
				</div>
				<div class="workflow-image">
					<img src="/assets/web-chat-compose.png" alt="Tycho Remote UI chat composer" />
					<img src="/assets/tui-chat-compose.png" alt="Tycho TUI chat composer" />
				</div>
			</section>
		</main>
	</body>
</html>
