---
import '../styles/site.css';
import DeviceFrame from '../components/DeviceFrame.astro';
import CommandBlock from '../components/CommandBlock.astro';
import StepScreenshot from '../components/StepScreenshot.astro';

const desktopScreenshot = '/assets/quickstart-watch-v0.16.0.png';
const desktopScreenshotAlt = 'Tycho Remote UI showing agent sessions with active work, completed results, and sessions that need input.';

const workflows = [
	{
		label: 'Launch',
		title: 'Start an agent session.',
		image: '/assets/quickstart-launch-v0.16.0.png',
		alt: 'Tycho quick agent modal populated for the registered Atlas Web project, ready to create and run a session.',
	},
	{
		label: 'Watch',
		title: 'See which sessions need attention.',
		image: desktopScreenshot,
		alt: desktopScreenshotAlt,
		width: 1440,
		height: 900,
	},
	{
		label: 'Answer',
		title: 'Answer a question or send a follow-up.',
		image: '/assets/quickstart-answer-v0.16.0.png',
		alt: 'Tycho Remote UI showing the Checkout rollout session waiting for a rollout-window decision.',
	},
	{
		label: 'Resume',
		title: 'Resume a session or run it again.',
		image: '/assets/quickstart-resume-v0.16.0.png',
		alt: 'Tycho Remote UI showing a completed Accessibility audit run and the composer for a follow-up.',
	},
];

const title = 'Tycho - Supervise coding agents.';
const description = 'Tycho helps you see which agent sessions deserve your attention.';
const ogImageAlt = 'Tycho v0.16.0 with agent sessions on a laptop and phone.';
const canonicalUrl = 'https://usetycho.com/';
const ogImage = 'https://usetycho.com/og-image.png';
const currentVersion = 'v0.16.0';
const currentReleaseUrl = `https://github.com/firewalker06/tycho/releases/tag/${currentVersion}`;
const changelogUrl = 'https://github.com/firewalker06/tycho/releases';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon-32x32.png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#11100e" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Tycho" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
	</head>
	<body>
		<header class="site-header">
			<div class="brand-lockup">
				<a class="brand" href="/" aria-label="Tycho home">
					<img src="/assets/tycho-logo-only.svg" alt="" />
					<span>Tycho</span>
				</a>
				<a class="version-badge" href={currentReleaseUrl} aria-label={`Tycho ${currentVersion} release notes`}>
					{currentVersion}
				</a>
			</div>
			<nav aria-label="Primary">
				<a href="/docs/getting-started/">Docs</a>
				<a href={changelogUrl}>Changelog</a>
				<a href="https://github.com/firewalker06/tycho">GitHub</a>
			</nav>
		</header>

		<main>
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Local-first</p>
					<h1>Supervise coding agents.</h1>
					<p class="lede">
						Tycho helps you see which agent sessions deserve your attention.
					</p>
					<p class="compatibility">
						Tycho stores your config, prompts, and logs locally.
						Works with Codex, Claude, OpenCode, and Pi.
					</p>
					<div class="actions">
						<a class="button primary" href="#install">Install Tycho</a>
						<a class="button secondary" href="https://github.com/firewalker06/tycho">View on GitHub</a>
					</div>
				</div>

				<div class="hero-visual">
					<DeviceFrame
						device="laptop"
						src={desktopScreenshot}
						alt={desktopScreenshotAlt}
						width={1920}
						height={1200}
						loading="eager"
					/>
					<DeviceFrame
						device="phone"
						src="/assets/remote-mobile-agents-v0.16.0.png"
						alt="Tycho Remote UI on a phone showing nine agent sessions in a filterable list."
						width={780}
						height={1688}
						loading="eager"
					/>
				</div>
			</section>


			<section class="installation" id="install" aria-labelledby="install-heading">
				<div class="section-heading">
					<p class="eyebrow">Get started</p>
					<h2 id="install-heading">Start your first agent.</h2>
				</div>
				<p>Install and sign in to <a href="/docs/configuration/harnesses/">a supported agent CLI</a> first.</p>
				<tycho-tabs class="installation-platform">
					<div class="install-tabs" role="tablist" aria-label="Installation platform">
						<button type="button" id="install-tab-macos" role="tab" aria-selected="true" aria-controls="install-panel-macos" tabindex="0">macOS</button>
						<button type="button" id="install-tab-linux" role="tab" aria-selected="false" aria-controls="install-panel-linux" tabindex="-1">Linux</button>
						<button type="button" id="install-tab-windows" role="tab" aria-selected="false" aria-controls="install-panel-windows" tabindex="-1">Windows WSL2</button>
					</div>
					<section class="install-panel" id="install-panel-macos" role="tabpanel" aria-labelledby="install-tab-macos" tabindex="0">
						<p>Requires macOS Tahoe on Apple Silicon and Homebrew.</p>
						<CommandBlock label="macOS install and start" command={'brew tap firewalker06/tycho\nbrew install tycho\ntycho --version\ntycho serve \\\n  --host 127.0.0.1 \\\n  --port 7373'} />
					</section>
					<section class="install-panel" id="install-panel-linux" role="tabpanel" aria-labelledby="install-tab-linux" tabindex="0" hidden>
						<p>Requires Linux x86_64 and Homebrew.</p>
						<CommandBlock label="Linux install and start" command={'brew tap firewalker06/tycho\nbrew install tycho\ntycho --version\ntycho serve \\\n  --host 127.0.0.1 \\\n  --port 7373'} />
						<p>For other Linux targets, <a href="/docs/getting-started/#install-from-source">install from source</a>.</p>
					</section>
					<section class="install-panel" id="install-panel-windows" role="tabpanel" aria-labelledby="install-tab-windows" tabindex="0" hidden>
						<p>Install the <a href="/docs/getting-started/#requirements">source requirements</a> inside WSL2 first. Run these commands in your Linux terminal.</p>
						<CommandBlock label="WSL2 source install and start" command={'git clone --branch v0.16.0 \\\n  https://github.com/firewalker06/tycho.git\ncd tycho\nbin/setup --check\nbin/setup\nbin/tycho --version\nbin/tycho serve \\\n  --host 127.0.0.1 \\\n  --port 7373'} />
					</section>
				</tycho-tabs>
				<tycho-tabs class="first-agent-steps">
					<div class="step-tabs" role="tablist" aria-label="First agent steps" aria-orientation="vertical">
						<button type="button" id="step-tab-browser" role="tab" aria-controls="step-panel-browser" aria-selected="true" tabindex="0"><span aria-hidden="true">1</span>Open browser</button>
						<button type="button" id="step-tab-welcome" role="tab" aria-controls="step-panel-welcome" aria-selected="false" tabindex="-1"><span aria-hidden="true">2</span>Welcome Sandbox</button>
						<button type="button" id="step-tab-harness" role="tab" aria-controls="step-panel-harness" aria-selected="false" tabindex="-1"><span aria-hidden="true">3</span>Choose a harness</button>
						<button type="button" id="step-tab-prompt" role="tab" aria-controls="step-panel-prompt" aria-selected="false" tabindex="-1"><span aria-hidden="true">4</span>Run an agent</button>
					</div>
					<div class="step-panels">
						<section id="step-panel-browser" class="step-panel" role="tabpanel" aria-labelledby="step-tab-browser" tabindex="0">
							<p>Keep the terminal open and visit <a href="http://127.0.0.1:7373">127.0.0.1:7373</a> in your browser.</p>
							<StepScreenshot step="browser" alt="Tycho v0.16.0 first-run setup instructions and Create Welcome Sandbox button." />
						</section>
						<section id="step-panel-welcome" class="step-panel" role="tabpanel" aria-labelledby="step-tab-welcome" tabindex="0" hidden>
							<p>Select <strong>Create Welcome Sandbox</strong>, or open the existing project.</p>
							<StepScreenshot step="welcome" alt="The built-in Welcome Sandbox project in Tycho v0.16.0, with its New agent button." />
						</section>
						<section id="step-panel-harness" class="step-panel" role="tabpanel" aria-labelledby="step-tab-harness" tabindex="0" hidden>
							<p>Choose <strong>New agent</strong>. In <strong>Options</strong>, open <strong>Advanced</strong> and select your signed-in harness.</p>
							<StepScreenshot step="harness" alt="The Harness field in Tycho v0.16.0 with Codex selected." />
						</section>
						<section id="step-panel-prompt" class="step-panel" role="tabpanel" aria-labelledby="step-tab-prompt" tabindex="0" hidden>
							<p>Enter a prompt and select <strong>Create and Run</strong>.</p>
							<CommandBlock label="Starter prompt" command="Read README.md and notes.md. Add one practical next step to notes.md, then summarize the change." />
							<StepScreenshot step="prompt" alt="Tycho v0.16.0 New agent form with the starter prompt and Create and Run button." />
						</section>
					</div>
				</tycho-tabs>
			</section>

			<section class="workflow" aria-labelledby="workflow-heading">
				<div class="section-heading workflow-heading">
					<p class="eyebrow">Agent sessions</p>
					<h2 id="workflow-heading">Follow an agent session.</h2>
				</div>
				<tycho-carousel class="workflow-carousel">
					<ol class="workflow-tabs" aria-label="Quickstart steps">
						{workflows.map((item, index) => (
							<li>
								<a
									class="workflow-tab"
									href={`#workflow-panel-${index + 1}`}
									id={`workflow-tab-${index + 1}`}
									data-carousel-tab
								>
									<span class="workflow-tab-number" aria-hidden="true">{index + 1}</span>
									<span>{item.label}</span>
								</a>
							</li>
						))}
					</ol>
					<ol class="workflow-panels">
						{workflows.map((item, index) => (
							<li
								class="workflow-panel"
								id={`workflow-panel-${index + 1}`}
								aria-labelledby={`workflow-tab-${index + 1}`}
								data-carousel-panel
							>
								<div class="workflow-panel-heading">
									<span class="workflow-panel-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
									<h3>{item.title}</h3>
								</div>
								<figure>
									<img
										class="workflow-screenshot"
										src={item.image}
										alt={item.alt}
										width={item.width ?? 1440}
										height={item.height ?? 900}
										loading={index === 0 ? 'eager' : 'lazy'}
										decoding="async"
									/>
								</figure>
							</li>
						))}
					</ol>
				</tycho-carousel>
				<a class="text-link workflow-quickstart-link" href="/docs/getting-started/">Read the quickstart</a>
			</section>
		</main>
		<script>
			class TychoTabs extends HTMLElement {
				connectedCallback() {
					const vertical = this.querySelector('[role="tablist"]')?.getAttribute('aria-orientation') === 'vertical';
					const tabs = [...this.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
					const panels = [...this.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
					const select = (index: number, focus = false) => {
						tabs.forEach((tab, current) => {
							const selected = current === index;
							tab.setAttribute('aria-selected', String(selected));
							tab.tabIndex = selected ? 0 : -1;
							panels[current].hidden = !selected;
						});
						if (focus) tabs[index].focus();
					};
					tabs.forEach((tab, index) => {
						tab.addEventListener('click', () => select(index));
						tab.addEventListener('keydown', (event) => {
							let next;
							if (event.key === (vertical ? 'ArrowDown' : 'ArrowRight')) next = (index + 1) % tabs.length;
							else if (event.key === (vertical ? 'ArrowUp' : 'ArrowLeft')) next = (index - 1 + tabs.length) % tabs.length;
							else if (event.key === 'Home') next = 0;
							else if (event.key === 'End') next = tabs.length - 1;
							else return;
							event.preventDefault();
							select(next, true);
						});
					});
				}
			}
			if (!customElements.get('tycho-tabs')) customElements.define('tycho-tabs', TychoTabs);

			class TychoCarousel extends HTMLElement {
				connectedCallback() {
					const tabs = [...this.querySelectorAll('[data-carousel-tab]')];
					const panels = [...this.querySelectorAll('[data-carousel-panel]')];
					if (tabs.length === 0 || tabs.length !== panels.length) return;

					const tablist = this.querySelector('.workflow-tabs');
					const panelList = this.querySelector('.workflow-panels');
					tablist?.setAttribute('role', 'tablist');
					panelList?.setAttribute('role', 'none');
					tabs.forEach((tab) => tab.parentElement?.setAttribute('role', 'presentation'));
					tabs.forEach((tab, index) => {
						tab.setAttribute('role', 'tab');
						tab.setAttribute('aria-controls', panels[index].id);
					});
					panels.forEach((panel) => {
						panel.setAttribute('role', 'tabpanel');
						panel.setAttribute('tabindex', '0');
					});

					const select = (selectedIndex, moveFocus = false) => {
						tabs.forEach((tab, index) => {
							const selected = index === selectedIndex;
							tab.setAttribute('aria-selected', String(selected));
							tab.setAttribute('tabindex', selected ? '0' : '-1');
							panels[index].hidden = !selected;
						});
						if (moveFocus) tabs[selectedIndex].focus();
					};

					const hashIndex = panels.findIndex((panel) => `#${panel.id}` === window.location.hash);
					select(hashIndex >= 0 ? hashIndex : 0);

					tabs.forEach((tab, index) => {
						tab.addEventListener('click', (event) => {
							event.preventDefault();
							select(index);
						});
							tab.addEventListener('keydown', (event) => {
							let nextIndex;
							switch (event.key) {
								case 'Enter':
								case ' ':
									nextIndex = index;
									break;
								case 'ArrowRight':
								case 'ArrowDown':
									nextIndex = (index + 1) % tabs.length;
									break;
								case 'ArrowLeft':
								case 'ArrowUp':
									nextIndex = (index - 1 + tabs.length) % tabs.length;
									break;
								case 'Home':
									nextIndex = 0;
									break;
								case 'End':
									nextIndex = tabs.length - 1;
									break;
								default:
									return;
							}
							event.preventDefault();
							select(nextIndex, true);
						});
					});
				}
			}

			if (!customElements.get('tycho-carousel')) customElements.define('tycho-carousel', TychoCarousel);
		</script>
	</body>
</html>
